{
    "version": 4,
    "env": {
        "app": [
            "${workspaceFolder}/inc/**",
            "${workspaceFolder}/tmp/**",
            "${workspaceFolder}/src/**"
        ]
    },
    "configurations": [
        {
            "name": "cmake",
            "configurationProvider": "ms-vscode.cmake-tools",
            "mergeConfigurations": true,
            "includePath": [
                "${app}"
            ],
            "defines": [
                "STM32F4",
                "F429DISCO", "STM32F429ZI", "STM32F429xx"
            ]
        }
    ]
}
